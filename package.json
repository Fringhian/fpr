{
  "name": "fpr",
  "private": true,
  "description": "A share-portfolio leaderboard",
  "type": "module",
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "dev:deps": "export COMPOSE_FILE=compose.yaml:compose.dev.yaml COMPOSE_PROFILES=storage && docker compose up --detach --wait postgres rustfs victorialogs vector && docker compose run --rm rustfs-bucket",
    "build": "pnpm --recursive --if-present run build",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "format": "biome check --write .",
    "prepare": "lefthook install",
    "contracts:openapi": "pnpm --filter @fpr/contracts run openapi",
    "db:migrate": "pnpm --filter @fpr/api run db:migrate"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
