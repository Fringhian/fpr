{
  "name": "fpr",
  "private": true,
  "description": "A share-portfolio leaderboard",
  "type": "module",
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "build": "pnpm --recursive --if-present run build",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "format": "biome check --write .",
    "prepare": "lefthook install"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
