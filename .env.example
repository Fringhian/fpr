# Copy to .env and fill in. Secrets are long random strings, such as `openssl rand -hex 32`.
# Variables with a default can stay empty.

# Postgres container
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Shared by api and prices
DATABASE_URL=
PRICES_TOKEN=
# Default Europe/Paris
RACE_TIMEZONE=

# api
# Default 3000
PORT=
PUBLIC_URL=
BETTER_AUTH_SECRET=
ADMIN_BOOTSTRAP_KEY=
PSEUDONYM_SECRET=
PRICES_URL=

# Picture storage, S3-compatible. With the storage profile, the rustfs
# container takes its credentials from these and creates S3_BUCKET.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# prices
# eodhd
PRICE_PROVIDER=
PRICE_PROVIDER_API_KEY=
# Default https://api.frankfurter.dev
RATES_URL=
# Default 1000
PROVIDER_DAILY_CALL_LIMIT=
# Cron expression. Default */30 9-22 * * 1-5
REFRESH_SCHEDULE=

# Loopback ports the host's reverse proxy forwards to
# Default 8081 for web
WEB_PORT=
# Default 9428 for victorialogs
LOGS_PORT=

# Logs
# Default 100y
LOGS_RETENTION=
# Default 20GB
LOGS_MAX_DISK=
LOGS_USERNAME=
LOGS_PASSWORD=
