{
  "name": "@fpr/api",
  "version": "0.0.0",
  "private": true,
  "description": "FPR's REST API: accounts, access, portfolios, shares, leaderboards, and the admin area",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=../../.env --conditions=@fpr/source src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "NODE_ENV=development tsx --env-file-if-exists=../../.env --conditions=@fpr/source src/migrate.ts",
    "auth:schema": "auth generate --config auth.config.ts --output /dev/stdout --yes",
    "db:seed": "NODE_ENV=${NODE_ENV:-development} tsx --env-file-if-exists=../../.env --conditions=@fpr/source src/seed/seed.ts"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@fpr/contracts": "workspace:*",
    "@fpr/db": "workspace:*",
    "@orpc/client": "1.16.1",
    "@orpc/contract": "1.16.1",
    "@orpc/openapi": "1.16.1",
    "@orpc/openapi-client": "1.16.1",
    "@orpc/server": "1.16.1",
    "@orpc/zod": "1.16.1",
    "@scalar/express-api-reference": "0.10.35",
    "better-auth": "1.7.23",
    "express": "5.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@smithy/util-stream": "4.8.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "auth": "1.7.23",
    "aws-sdk-client-mock": "4.1.0",
    "kysely": "0.29.8",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15"
  }
}
