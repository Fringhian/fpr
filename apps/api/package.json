{
  "name": "@fpr/api",
  "version": "0.0.0",
  "private": true,
  "description": "FPR's REST API: accounts, access, portfolios, shares, leaderboards, and the admin area",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=../../.env --conditions=@fpr/source src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "NODE_ENV=development tsx --env-file-if-exists=../../.env --conditions=@fpr/source src/migrate.ts"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@fpr/contracts": "workspace:*",
    "@fpr/db": "workspace:*",
    "@orpc/openapi": "1.16.1",
    "@orpc/server": "1.16.1",
    "@orpc/zod": "1.16.1",
    "@scalar/express-api-reference": "0.10.35",
    "express": "5.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15"
  }
}
