{
  // Visit https://aka.ms/tsconfig to read more about this file
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // File Layout
    "outDir": "./dist",
    // An app: nothing imports its types, and the router's inferred type is
    // too long to write to a declaration file.
    "declaration": false,
    "declarationMap": false,

    // Environment Settings
    "types": ["node"]
  },
  "include": ["src", "test"]
}
