:80 {
	root * /srv

	log {
		output stdout
		format json
	}

	# Access keys travel in the path (/access/<key>). Keep those requests out of the log.
	@access path /access/*
	log_skip @access

	header Referrer-Policy no-referrer

	handle /api/* {
		reverse_proxy api:3000 {
			header_down -Referrer-Policy
		}
	}

	# Hashed build assets. A missing one answers 404, never index.html, and is not cached.
	@asset {
		path /assets/*
		file
	}

	handle @asset {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /assets/* {
		header Cache-Control no-cache
		respond 404
	}

	# index.html, the service worker and the manifest, and every route the app serves.
	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
