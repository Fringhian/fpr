    "/access/check": {
      "post": {
        "operationId": "access.check",
        "summary": "An access key's state, and who it is for while waiting",
        "tags": [
          "access"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{43}$"
                  }
                },
                "required": [
                  "key"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "state": {
                              "const": "waiting"
                            },
                            "signsInWith": {
                              "const": "password"
                            },
                            "email": {
                              "type": "string",
                              "format": "email",
                              "x-anonymize": "personal"
                            },
                            "displayName": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 40,
                              "x-anonymize": "personal"
                            },
                            "hasPassword": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "state",
                            "signsInWith",
                            "email",
                            "displayName",
                            "hasPassword"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "state": {
                              "const": "waiting"
                            },
                            "signsInWith": {
                              "const": "link"
                            }
                          },
                          "required": [
                            "state",
                            "signsInWith"
                          ]
                        }
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "enum": [
                            "claimed",
                            "expired",
                            "replaced",
                            "revoked",
                            "ended"
                          ],
                          "type": "string"
                        },
                        "signsInWith": {
                          "enum": [
                            "password",
                            "link"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "state",
                        "signsInWith"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "const": "unknown"
                        }
                      },
                      "required": [
                        "state"
                      ]
                    }
