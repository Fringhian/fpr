{
  "openapi": "3.1.1",
  "info": {
    "title": "FPR API",
    "version": "1",
    "description": "Generated from the route contracts in `@fpr/contracts` by `pnpm contracts:openapi`. `x-roles` lists the roles a route accepts. `x-anonymize` marks a field the anonymizer replaces for an anonymous viewer: `personal`, `euro`, or `quantity`."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "summary": "The signed-in person",
        "x-roles": [
          "admin",
          "member",
          "guest",
          "anonymous"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "admin",
                        "member",
                        "guest",
                        "anonymous"
                      ]
                    },
                    "displayName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40,
                      "x-anonymize": "personal"
                    },
                    "avatarUrl": {
                      "x-anonymize": "personal",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "color": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    },
                    "language": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "fr",
                            "en"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "onboarded": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "role",
                    "displayName",
                    "avatarUrl",
                    "color",
                    "language",
                    "onboarded"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`, `access_ended`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "unauthenticated",
                            "access_ended"
                          ]
                        },
                        "details": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "`internal_error`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "internal_error"
                          ]
                        },
                        "details": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
