{
  "name": "@fpr/contracts",
  "description": "Zod schemas for the REST API",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit --project scripts",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@fpr/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15"
  }
}
