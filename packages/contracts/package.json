{
  "name": "@fpr/contracts",
  "description": "Route contracts for the API and the price service",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit --project scripts",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@orpc/contract": "1.16.1",
    "@orpc/openapi": "1.16.1",
    "@orpc/zod": "1.16.1",
    "zod": "4.6.7"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@fpr/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prices": {
      "@fpr/source": "./src/prices/index.ts",
      "types": "./dist/prices/index.d.ts",
      "default": "./dist/prices/index.js"
    },
    "./openapi": {
      "@fpr/source": "./src/openapi.ts",
      "types": "./dist/openapi.d.ts",
      "default": "./dist/openapi.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15"
  }
}
